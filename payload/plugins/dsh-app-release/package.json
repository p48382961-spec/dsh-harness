{
  "name": "dsh-app-release",
  "version": "0.2.0",
  "private": true,
  "description": "外壳与引擎的版本、检查更新与一键升级；客户端复刻桌面端的「应用」栏（关于 / 检查更新）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
