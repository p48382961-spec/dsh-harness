{
  "name": "dsh-plugin-restart",
  "version": "1.2.0",
  "private": true,
  "description": "DSH Web 重启插件：侧栏底部一颗按钮 + 模型可调用的 restart_server 工具，二者共用 ~/dsh-restart.sh",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
